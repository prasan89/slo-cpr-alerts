# FYERS read-only market-data credentials
# Do NOT commit real credentials.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# Optional Groww credentials (kept as a second provider).
GROWW_ACCESS_TOKEN=

# Comma-separated underlying NSE symbols to monitor.
# NIFTY and BANKNIFTY are mapped to FYERS index symbols.
# Stock symbols are mapped to NSE:<SYMBOL>-EQ.
SLO_SYMBOLS=NIFTY,BANKNIFTY,SUNPHARMA,RELIANCE,INFY
